# OPENROUTER_API_KEY: Required key for Coach Jarvis, which runs exclusively on OpenRouter
# (Claude 3.5 Sonnet, Llama 3.3 70B, GPT-4o, DeepSeek, etc.)
# Users configure this via Settings > Secrets panel or via the AI Coach Model Config.
OPENROUTER_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
