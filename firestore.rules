rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // STANDALONE GLOBAL HELPER FUNCTIONS
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Schema and boundary validation for manager team profiles
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'teamName']) &&
             data.email is string && data.email.size() <= 128 &&
             data.teamName is string && data.teamName.size() <= 128;
    }

    // Schema and boundary validation for lightweight auth credentials
    function isValidAuth(data) {
      return data.keys().hasAll(['email', 'password', 'uid', 'role']) &&
             data.email is string && data.email.size() <= 128 &&
             data.password is string && data.password.size() <= 128 &&
             data.uid is string && data.uid.size() <= 128 &&
             data.role is string && (data.role == 'admin' || data.role == 'manager');
    }

    // Schema and boundary validation for Coach Jarvis chat sessions
    function isValidCoachChat(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'messages', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.title is string && data.title.size() <= 256 &&
             data.messages is list &&
             data.createdAt is string &&
             data.updatedAt is string;
    }

    // 1. Users collection: Core Battrick manager rosters, finances, fixtures, and settings
    match /users/{userId} {
      allow get, list, create, update, delete: if true; // list: used by the Admin dashboard

      // Sub-collection for persistent Coach Jarvis chat history
      match /chats/{chatId} {
        allow read, write: if true;
      }

      // Jarvis OpenRouter key + model (and future per-user settings)
      match /settings/{settingId} {
        // get only: the Jarvis key can't be listed/enumerated, only fetched by someone who already
        // knows the exact path. Real protection needs Firebase Authentication (see README note).
        allow get, create, update, delete: if true;
        allow list: if false;
      }
    }

    // 1b. Per-user app data mirror (match archive, scouted opponent squads, etc.)
    match /users_data/{userId}/{document=**} {
      allow read, write: if true;
    }

    // 2. Users Auth credentials (custom login). The app only ever GETs one account (login)
    // and CREATEs a new one (sign-up), so that is all that is allowed: no listing, no updates
    // (nobody can overwrite another account's password or uid), no deletes, and sign-up cannot
    // replace an existing account.
    match /users_auth/{email} {
      allow get: if true;
      allow list: if false;
      allow create: if isValidAuth(request.resource.data)
                    && request.resource.data.email == email
                    && !exists(/databases/$(database)/documents/users_auth/$(email));
      allow update, delete: if false;
    }
  }
}
