rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // STANDALONE GLOBAL HELPER FUNCTIONS
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Schema and boundary validation for manager team profiles
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'teamName']) &&
             data.email is string && data.email.size() <= 128 &&
             data.teamName is string && data.teamName.size() <= 128;
    }

    // Schema and boundary validation for lightweight auth credentials
    function isValidAuth(data) {
      return data.keys().hasAll(['email', 'password', 'uid', 'role']) &&
             data.email is string && data.email.size() <= 128 &&
             data.password is string && data.password.size() <= 128 &&
             data.uid is string && data.uid.size() <= 128 &&
             data.role is string && (data.role == 'admin' || data.role == 'manager');
    }

    // Schema and boundary validation for Coach Jarvis chat sessions
    function isValidCoachChat(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'messages', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.title is string && data.title.size() <= 256 &&
             data.messages is list &&
             data.createdAt is string &&
             data.updatedAt is string;
    }

    // ---- Access model -------------------------------------------------------------------
    // Callers sign in with Firebase Authentication (email + password). Each account has a mapping
    // document users_auth/{email} -> { uid } where uid is the id its data is stored under
    // (legacy ids like bt_andrew_admin are preserved, so no data had to move).
    // A caller may touch users/{uid} and users_data/{uid} only if THEIR mapping points at that uid.
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }
    function emailKey() {
      return request.auth.token.email.lower();
    }
    function ownsUid(userId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/users_auth/$(emailKey())) &&
        get(/databases/$(database)/documents/users_auth/$(emailKey())).data.uid == userId;
    }
    function isAdminUser() {
      return signedIn() && emailKey() == 'andrewpbrown33@gmail.com';
    }

    // 1. Users collection: rosters, finances, fixtures, settings
    match /users/{userId} {
      allow get, create, update, delete: if ownsUid(userId);
      allow list: if isAdminUser(); // Admin dashboard

      match /chats/{chatId} {
        allow read, write: if ownsUid(userId);
      }

      // Jarvis OpenRouter key + model, per-user settings
      match /settings/{settingId} {
        allow read, write: if ownsUid(userId);
      }
    }

    // 1b. Per-user app data mirror (match archive, scouted opponent squads, etc.)
    match /users_data/{userId}/{document=**} {
      allow read, write: if ownsUid(userId);
    }

    // 2. Account mapping (and, until a legacy account is migrated, its old password field).
    match /users_auth/{email} {
      // Legacy documents that still hold a password stay readable so the old password can be
      // verified once at first login; migrated documents (no password) are owner-only.
      allow get: if (signedIn() && emailKey() == email) ||
                    (resource != null && resource.data.keys().hasAny(['password']));
      allow list: if false;
      allow create: if signedIn() && emailKey() == email &&
                    request.resource.data.email == email &&
                    request.resource.data.uid is string && request.resource.data.uid.size() <= 128 &&
                    request.resource.data.role in ['admin', 'manager'] &&
                    (request.resource.data.role == 'manager' || email == 'andrewpbrown33@gmail.com') &&
                    !('password' in request.resource.data) &&
                    !exists(/databases/$(database)/documents/users_auth/$(email));
      // Owner may update their mapping (this is how a legacy password gets stripped) but never
      // change the uid it points at, and never re-add a password.
      allow update: if signedIn() && emailKey() == email &&
                    request.resource.data.uid == resource.data.uid &&
                    request.resource.data.email == email &&
                    request.resource.data.role in ['admin', 'manager'] &&
                    (request.resource.data.role == 'manager' || email == 'andrewpbrown33@gmail.com') &&
                    !('password' in request.resource.data);
      allow delete: if false;
    }
  }
}
